<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <block type="trade_definition" id="trend-definition" x="20" y="20">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="trend-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">volatility_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="trend-tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">multiplier</field>
            <field name="TRADETYPE_LIST">multiplier</field>
            <next>
              <block type="trade_definition_contracttype" id="trend-contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="trend-candleinterval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="trend-restartbuysell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="trend-restartonerror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">FALSE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_multiplier" id="trend-multiplier">
        <field name="MULTIPLIERTYPE_LIST">10</field>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="trend-stake">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <statement name="MULTIPLIER_PARAMS">
          <block type="multiplier_take_profit" id="trend-take-profit">
            <value name="AMOUNT">
              <shadow type="math_number_positive" id="trend-tp-value">
                <field name="NUM">0.50</field>
              </shadow>
            </value>
            <next>
              <block type="multiplier_stop_loss" id="trend-stop-loss">
                <value name="AMOUNT">
                  <shadow type="math_number_positive" id="trend-sl-value">
                    <field name="NUM">1.00</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="trend-before-purchase" x="20" y="520">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="trend-purchase">
        <field name="PURCHASE_LIST">CALL</field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="trend-after-purchase" x="500" y="20">
    <statement name="AFTERPURCHASE_STACK">
      <block type="trade_again" id="trend-trade-again" />
    </statement>
  </block>
</xml>
